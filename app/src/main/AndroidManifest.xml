<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A testvér-app (Zigbee hub ↔ Matter-egység) jelzései: "most én használom a Tailscale-t" – csak az azonos kulccsal
         aláírt appok küldhetik (mindkét app ugyanezt az engedélyt hozza létre, ugyanazzal a kulccsal: ez megengedett) -->
    <permission
        android:name="hu.zigbeehub.permission.SIBLING"
        android:protectionLevel="signature" />
    <uses-permission android:name="hu.zigbeehub.permission.SIBLING" />

    <!-- a Tailscale app: látni kell, hogy telepítve van-e, és kérést küldeni neki (be / ki); a testvér-app: jelezni neki -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <package android:name="hu.zigbeehub.app" />
        <package android:name="hu.zigbeehub.app.matter" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".OffReceiver"
            android:exported="false" />

        <!-- a testvér-app jelzései (előtérbe került / háttérbe került) -->
        <receiver
            android:name=".SiblingReceiver"
            android:exported="true"
            android:permission="hu.zigbeehub.permission.SIBLING" />
    </application>
</manifest>
